{
  "routes": [
    {
      "src": "/sw[.]js",
      "has": [{ "type": "host", "value": "penerapan-pythagoras.vercel.app" }],
      "dest": "/sw-mati.js",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "penerapan-pythagoras.vercel.app" }],
      "status": 404,
      "dest": "/link-mati.html"
    }
  ]
}
